# Legilimens — root environment template
# Copy to `.env` and fill in. Never commit the real `.env`.

# ─── Actian VectorAI DB (retrieval brain) ──────────────────────────
VECTORAI_HOST=localhost
VECTORAI_PORT=6574          # gRPC (Python SDK default); REST is 6573

# ─── Actian Vector (columnar analytics) ────────────────────────────
VECTOR_HOST=localhost
VECTOR_PORT=5432            # TODO VERIFY: confirm Actian Vector's default SQL port
VECTOR_DATABASE=actian
VECTOR_USER=admin
VECTOR_PASSWORD=password

# ─── Cloud generative step (the only thing that leaves the building) ─
GEMINI_API_KEY=your_gemini_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ─── Whisper.cpp (ASR — stretch goal, not core) ────────────────────
WHISPER_MODEL_PATH=./models/ggml-base.en.bin

# ─── Frontend → backend URL ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
