# Legilimens MCP Server Environment Variables
# Copy to .env and fill in your API keys

# ───────────────────────────────────────────────────────────────
# Actian VectorAI DB (Qdrant) — Vector Retrieval
# ───────────────────────────────────────────────────────────────
VECTORAI_HOST=localhost
VECTORAI_PORT=6574
VECTORAI_COLLECTION=lecture_chunks
VECTORAI_DIM=384

# ───────────────────────────────────────────────────────────────
# Actian Vector (Analytics Engine) — Columnar SQL
# ───────────────────────────────────────────────────────────────
VECTOR_HOST=localhost
VECTOR_PORT=5432
VECTOR_DATABASE=actian
VECTOR_USER=admin
VECTOR_PASSWORD=password

# ───────────────────────────────────────────────────────────────
# Embedder — bge-small-en
# ───────────────────────────────────────────────────────────────
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5

# ───────────────────────────────────────────────────────────────
# Gemini API — Analogy Rewrite (Gemino)
# ───────────────────────────────────────────────────────────────
# Get key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ───────────────────────────────────────────────────────────────
# ElevenLabs API — TTS Voice (Sonorus)
# ───────────────────────────────────────────────────────────────
# Get key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (calm tutor)
ELEVENLABS_MODEL_ID=eleven_monolingual_v1