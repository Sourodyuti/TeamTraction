# Legilimens — backend environment template
# Copy to `backend/.env` (docker-compose reads the root `.env` instead).
# These are also available via config.py with sensible local-dev defaults.

VECTORAI_HOST=localhost
VECTORAI_PORT=6574
VECTORAI_COLLECTION=lecture_chunks
VECTORAI_DIM=384

VECTOR_HOST=localhost
VECTOR_PORT=5432
VECTOR_DATABASE=actian
VECTOR_USER=admin
VECTOR_PASSWORD=password

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
NVIDIA_API_KEY=                          # https://build.nvidia.com/ — free tier, fallback when Gemini 429s
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

WHISPER_MODEL_PATH=./models/ggml-base.en.bin

# MongoDB Atlas (user auth)
MONGODB_URI=
MONGODB_DB_NAME=legilimens

# JWT
LEGILIMENS_SECRET=legilimens-default-dev-secret-change-in-prod
LEGILIMENS_PASSWORD=Legilimens2026
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
