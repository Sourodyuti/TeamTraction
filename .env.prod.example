# Legilimens — Production Environment Variables
# Copy this to .env.prod and fill in real values.
# NEVER commit .env.prod to git.

# ─── Actian VectorAI DB ──────────────────────────────────────────
VECTORAI_HOST=vectorai-db   # Docker service name in docker-compose.prod.yml
VECTORAI_PORT=6574
VECTORAI_COLLECTION=lecture_chunks
VECTORAI_DIM=384
ACTIAN_VECTORAI_LICENSE_KEY=***REDACTED_ACTIAN_LICENSE_KEY***

# ─── Actian Vector SQL ────────────────────────────────────────────
VECTOR_HOST=actian-vector   # Docker service name
VECTOR_PORT=5432
VECTOR_DATABASE=actian
VECTOR_USER=admin
VECTOR_PASSWORD=CHANGE_ME

# ─── MongoDB Atlas (user auth) ────────────────────────────────────
MONGODB_URI=mongodb+srv://***REDACTED_MONGO_USER***:YOUR_PASSWORD@***REDACTED_MONGO_HOST***/?appName=Cluster0
MONGODB_DB_NAME=legilimens

# ─── JWT ─────────────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERATE_A_STRONG_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=10080

# ─── Gemini ───────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# ─── ElevenLabs ──────────────────────────────────────────────────
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ─── CORS ────────────────────────────────────────────────────────
# Add your DigitalOcean domain here
CORS_ORIGINS=["https://YOUR_DOMAIN","http://YOUR_DROPLET_IP","http://localhost:3000"]
